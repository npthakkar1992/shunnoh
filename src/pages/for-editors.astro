<script>
  // Scroll reveal — .reveal elements plus the staged category headers
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
  );
  document
    .querySelectorAll(".editor-page .reveal, .editor-page .category-header")
    .forEach((el) => observer.observe(el));

  // Smooth anchor scroll (nav + style cards). Targets carry scroll-margin-top: 96px.
  document.querySelectorAll('.editor-page a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      const target = document.querySelector(this.getAttribute("href"));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    });
  });

  // Effects 2.7 / 2.8 / 2.9 — sticky category label, background shift, active card.
  // One throttled scroll handler tracks which category section spans the viewport middle.
  const page = document.querySelector(".editor-page");
  const stickyLabel = document.querySelector(".category-sticky-label");
  const sections = Array.from(document.querySelectorAll("[data-category-section]"));
  const styleCards = Array.from(document.querySelectorAll(".style-card[data-category]"));
  let currentCategory = null;

  function setActiveCategory(section) {
    const id = section ? section.dataset.categorySection : null;
    if (id === currentCategory) return;
    currentCategory = id;

    if (stickyLabel) {
      if (section) {
        stickyLabel.textContent = section.dataset.categoryLabel;
        stickyLabel.classList.add("is-visible");
      } else {
        stickyLabel.classList.remove("is-visible");
      }
    }
    if (page) {
      page.classList.toggle("bg-parchment", !!section && section.dataset.bg === "parchment");
    }
    styleCards.forEach((card) => {
      card.classList.toggle("is-active", card.dataset.category === id);
    });
  }

  let categoryTick = false;
  function updateCategory() {
    const mid = window.innerHeight / 2;
    let active = null;
    for (const s of sections) {
      const rect = s.getBoundingClientRect();
      if (rect.top <= mid && rect.bottom >= mid) { active = s; break; }
    }
    setActiveCategory(active);
    categoryTick = false;
  }
  window.addEventListener("scroll", () => {
    if (!categoryTick) { categoryTick = true; requestAnimationFrame(updateCategory); }
  }, { passive: true });
  updateCategory();

  // Excerpt lightbox — click a strip image to view it larger in a centred overlay.
  const lightbox = document.querySelector("[data-lightbox]");
  const lightboxImg = lightbox?.querySelector("[data-lightbox-img]");
  if (lightbox && lightboxImg) {
    document.querySelectorAll("[data-lightbox-src]").forEach((btn) => {
      btn.addEventListener("click", () => {
        lightboxImg.src = btn.dataset.lightboxSrc;
        lightboxImg.alt = btn.querySelector("img")?.alt || "";
        lightbox.showModal();
      });
    });
    // Click anywhere (backdrop, image or close button) dismisses; Esc is native.
    lightbox.addEventListener("click", () => lightbox.close());
  }

  // Excerpt strips — side arrows move the row; they hide at either end.
  document.querySelectorAll("[data-excerpt-carousel]").forEach((carousel) => {
    const strip = carousel.querySelector("[data-excerpt-strip]");
    const prev = carousel.querySelector("[data-excerpt-prev]");
    const next = carousel.querySelector("[data-excerpt-next]");
    const sync = () => {
      const max = strip.scrollWidth - strip.clientWidth;
      prev.disabled = strip.scrollLeft <= 4;
      next.disabled = strip.scrollLeft >= max - 4;
    };
    const move = (dir) => strip.scrollBy({ left: dir * strip.clientWidth * 0.7 });
    prev.addEventListener("click", () => move(-1));
    next.addEventListener("click", () => move(1));
    let tick = false;
    strip.addEventListener("scroll", () => {
      if (!tick) { tick = true; requestAnimationFrame(() => { sync(); tick = false; }); }
    }, { passive: true });
    window.addEventListener("resize", sync, { passive: true });
    sync();
  });
</script>
