---
import BaseLayout from "../layouts/BaseLayout.astro";

const categories = [
  {
    id: "experiential",
    number: "01",
    labelShort: "Experiential Travel",
    titleLead: "Experiential Travel & ",
    titleEm: "Immersive",
    titleTail: " Writing",
    line: "Writing that puts the reader inside the moment — every sense engaged.",
    cardImage: "/images/blog/goa/hero.png",
    bgAlt: false,
    articles: [
      {
        title: "Goa's Glowing Forest",
        city: "Goa, India",
        pub: "Shunnoh",
        href: "/blogs/goa",
        image: "/images/blog/goa/card.png",
        imageAlt: "Goa's bioluminescent monsoon forest",
        preview: "Beyond its vibrant beaches, bustling casinos, and lively parties, Goa also has a lesser-known yet equally captivating side.",
      },
      {
        title: "Walking through the pages of Ruskin Bond",
        city: "Landour, India",
        pub: "Coming Soon",
        href: null,
        image: null,
        imageAlt: "Ruskin Bond's Landour",
        preview: "Tang, tang, tang, tang, tang, and it was five in the morning. The sound came through exactly the way he had written it.",
      },
      {
        title: "The Mountain's Will",
        city: "India",
        pub: "Coming Soon",
        href: null,
        image: null,
        imageAlt: "A high-altitude trek",
        preview: "As I looked at the sky, language became briefly inadequate. I had seen stars before, but I had not seen the sky before.",
      },
    ],
    excerpts: [
      { src: "/images/for-editors/excerpts/experiential/1.jpg", w: 1600, h: 1204, quote: "As I looked at the sky, language became briefly inadequate. I had seen stars before, but I had not seen the sky before. Not like this." },
      { src: "/images/for-editors/excerpts/experiential/2.jpg", w: 1600, h: 1138, quote: "I had come for the red slopes and blooming forests. Instead, the mountains gave me a sky I had never seen before and a shooting star I did not know I could ask for." },
      { src: "/images/for-editors/excerpts/experiential/3.jpg", w: 1600, h: 1138, quote: "Stepping off the plane, I noticed a fellow passenger pause — a silent, heartfelt greeting to the sacred city of ghats, Varanasi." },
      { src: "/images/for-editors/excerpts/experiential/4.jpg", w: 1600, h: 1138, quote: "With all our torches off, deep in the jungle, we found ourselves mesmerized by these enigmatic organisms. Even the moonlight felt intrusive." },
      { src: "/images/for-editors/excerpts/experiential/5.jpg", w: 1600, h: 1138, quote: "In the distance, cattle grazed on vibrant green slopes, their bells harmonizing with the birdsong. It made me re-believe my childhood sketches." },
      { src: "/images/for-editors/excerpts/experiential/6.jpg", w: 1600, h: 1138, quote: "Tang, tang, tang, tang, tang, and it was five in the morning. The clock tower was not a landmark I had to find on a map. It found me." },
    ],
  },
  {
    id: "destinations",
    number: "02",
    labelShort: "Destination Stories",
    titleLead: "Destination Stories and the ",
    titleEm: "Murmur",
    titleTail: " of History",
    line: "Places told through their people, their rituals, and the history beneath them.",
    cardImage: "/images/blog/sarnath/hero.jpg",
    bgAlt: true,
    articles: [
      {
        title: "Sarnath — Where the Wheel of Dharma was Turned",
        city: "Sarnath, India",
        pub: "Shunnoh",
        href: "/blogs/sarnath",
        image: "/images/blog/sarnath/card.png",
        imageAlt: "Sarnath, the cradle of Buddhism",
        preview: "Travelling just 8 kilometers from Varanasi will help you unfold a different side of spirituality.",
      },
      {
        title: "Varanasi — Here, you either find Him, or you lose faith in Him",
        city: "Varanasi, India",
        pub: "Shunnoh",
        href: "/blogs/varanasi",
        image: "/images/blog/varanasi/hero.jpg",
        imageAlt: "The ghats of Varanasi",
        preview: "Banaras, ghato ka shehar ya shiv ki nagri? A city etched in time; its stories whispered through ancient scriptures.",
      },
      {
        title: "Hoi An - The city that was forgotten to be remembered",
        city: "Hoi An, Vietnam",
        pub: "Coming Soon",
        href: null,
        image: null,
        imageAlt: "The old town of Hoi An",
        preview: "The town wasn't preserved because it was loved. It was preserved because it was forgotten. The love came afterwards.",
      },
    ],
    excerpts: [
      { src: "/images/for-editors/excerpts/destinations/1.jpg", w: 1600, h: 1066, quote: "The town wasn't preserved because it was loved. It was preserved because it was forgotten. The love came afterwards." },
      { src: "/images/for-editors/excerpts/destinations/2.jpg", w: 1528, h: 1600, quote: "These were the giếng trời, the sky wells, a layout born out of a tax hack. Centuries-old tax avoidance is now considered beautiful traditional architecture." },
      { src: "/images/for-editors/excerpts/destinations/3.jpg", w: 1600, h: 1200, quote: "A few kilometers from Varanasi, temple bells get replaced with bonshōs and damrus with prayer wheels. This is Sarnath." },
      { src: "/images/for-editors/excerpts/destinations/4.jpg", w: 1427, h: 1600, quote: "On the same bank of the Ganges, the glorious Ganga Aarti illuminates one side, while blazing funeral pyres flicker on the other." },
      { src: "/images/for-editors/excerpts/destinations/5.jpg", w: 1276, h: 1600, quote: "According to Vietnamese and Japanese folklore, Namazu is a giant catfish. The merchants built the bridge to pin the creature down." },
      { src: "/images/for-editors/excerpts/destinations/6.jpg", w: 1600, h: 1200, quote: "Over the years they compiled The Landour Cookbook — recipes attributed to actual women from a century ago: Mary Hoke's chocolate chip date cake, Vesta Miller's mud pie." },
    ],
  },
  {
    id: "craft",
    number: "03",
    labelShort: "Craft & Culture",
    titleLead: "Craft & Culture — The ",
    titleEm: "Making",
    titleTail: " of Things",
    line: "The artisans, the looms, and the hands that shape heritage.",
    cardImage: "/images/blog/banarasi-saree/hero.png",
    bgAlt: false,
    articles: [
      {
        title: "The Banarasi Saree — From the Gods, through the Royals, to the Masses",
        city: "Varanasi, India",
        pub: "Shunnoh",
        href: "/blogs/banarasi-saree",
        image: "/images/blog/banarasi-saree/hero.png",
        imageAlt: "Banarasi saree weaving",
        preview: "Banarasi saree, a bridal echo, a royal legacy; a testament to timeless elegance that has been defining affluence through eras.",
      },
      {
        title: "Poila Boishakh: A Slice Of History With A Bite Of Mishti",
        city: "Bengal, India",
        pub: "Outlook Traveller Eats",
        href: "https://oteats.outlooktraveller.com/features/guides/poila-boishakh-a-slice-of-history-with-a-bite-of-mishti",
        image: "/images/for-editors/excerpts/craft/4.jpg",
        focal: "bottom",
        imageAlt: "Alpona floor art at a Bengali thakur dalan",
        preview: "What started as a tax reform in 1556 is today a feast, a reason for families to gather at the turn of the Bengali new year.",
      },
      {
        title: "Hoi An - The city that was forgotten to be remembered",
        city: "Hoi An, Vietnam",
        pub: "Coming Soon",
        href: null,
        image: null,
        imageAlt: "Craft stories from Hoi An",
        preview: "Cao lầu, a noodle that is a prisoner of this town's geography. Not because of its recipe but because of its key ingredients.",
      },
    ],
    excerpts: [
      { src: "/images/for-editors/excerpts/craft/1.jpg", w: 1600, h: 1200, quote: "The rhythmic clatter of looms whispers of the artistry of Banarasi saree weaving. The lanes are awash with murky dye water flowing from countless small workshops." },
      { src: "/images/for-editors/excerpts/craft/2.jpg", w: 1200, h: 1600, quote: "Cao lầu, a noodle that is a prisoner of this town's geography. The name is a fossil. Cao means high. Lầu means floor. Once served to wealthy traders. Now, a street food." },
      { src: "/images/for-editors/excerpts/craft/3.jpg", w: 1600, h: 1118, quote: "The Naksha Pattas are the sole codes that these jacquard looms understand, much like binary codes are for computers." },
      { src: "/images/for-editors/excerpts/craft/4.jpg", w: 1200, h: 1600, quote: "What started as a tax reform in 1556 is today a feast, a reason for families to gather at the turn of the Bengali new year, long after they left the fields behind." },
      { src: "/images/for-editors/excerpts/craft/5.jpg", w: 1200, h: 1600, quote: "A Muslim community, where skilled weavers produced the iconic Banarasi sarees, a staple for Hindu weddings. The interweaving of cultures hinted at a deeper history." },
    ],
  },
];

// focal: top | center | bottom | left | right | custom "50% 25%" — maps to object-position
const focalMap = { top: "center top", center: "center", bottom: "center bottom", left: "left center", right: "right center" };
const objectPosition = (f) => focalMap[f ?? "center"] ?? f;

const skills = [
  "Consumer Research (Nielsen)", "Search Strategy & SEO", "Editorial Writing",
  "Travel Photography", "Cultural & Historical Research", "Hindi · Bengali · English",
];
---
<BaseLayout title="For Editors — Shunnoh" description="Barnali's editorial portfolio — immersive travel writing, cultural features, and destination storytelling for publications." noindex={true}>
  <div class="editor-page paper-texture">
    <!-- Sticky category label (reader orientation cue) -->
    <div class="category-sticky-label" aria-hidden="true"></div>

    <!-- NAV (frosted) -->
    <nav class="ed-nav">
      <a href="/" class="ed-nav-logo" aria-label="Shunnoh — home"><img src="/images/branding/logo-wordmark-dark.svg" alt="Shunnoh" class="ed-nav-logo-img" width="210" height="48" /></a>
      <ul class="ed-nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/blogs">Blog</a></li>
        <li><a href="https://www.instagram.com/shunnoh_" target="_blank" rel="noopener noreferrer">Get in Touch</a></li>
      </ul>
    </nav>

    <!-- HERO -->
    <section class="editor-hero">
      <div class="editor-hero-text">
      <div class="editor-hero-badge ed-load ed-load-badge">For Editors &amp; Publications</div>
      <h1 class="ed-load ed-load-h1">I don't write about destinations, I make you <em>live</em> through them.</h1>
      <p class="editor-hero-tagline ed-load ed-load-tagline">A writer who breathes life into your stories</p>
      <p class="editor-hero-intro ed-load ed-load-intro1">I'm Barnali, the writer behind Shunnoh. I specialise in immersive, research-rich travel features — the kind where a reader doesn't just learn about a place, they feel like they've been there. If your publication values depth, sensory detail, and cultural authenticity, we should talk.</p>
      </div>
      <div class="editor-hero-photo ed-load ed-load-photo">
        <img src="/images/for-editors/barnali.jpg" alt="Barnali, the writer behind Shunnoh, with her camera" width="900" height="1200" loading="eager" />
      </div>
    </section>

    <!-- STYLES OF WRITING (category card navigator) -->
    <section class="styles-section" id="styles-of-writing">
      <div class="styles-header reveal">
        <h2 class="section-heading">Styles of Writing</h2>
        <p class="styles-desc"><em>Three ways I approach a place.</em></p>
      </div>
      <div class="styles-grid">
        {categories.map((c) => (
          <a href={`#${c.id}`} class="style-card reveal" data-category={c.id}>
            <span class="style-card-media">
              <img src={c.cardImage} alt="" loading="lazy" decoding="async" aria-hidden="true" />
              <span class="style-card-scrim"></span>
            </span>
            <span class="style-card-overlay">
              <span class="style-card-title">{c.titleLead}{c.titleEm}{c.titleTail}</span>
              <span class="style-card-line">{c.line}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- CATEGORY SECTIONS -->
    {categories.map((c) => (
      <section class={`category-section ${c.bgAlt ? "bg-alt" : ""}`} id={c.id} data-category-section={c.id} data-category-label={`${c.number} — ${c.labelShort}`} data-bg={c.bgAlt ? "parchment" : "warm-white"}>
        <div class="category-header">
          <div class="category-number">{c.number}</div>
          <h2 class="category-title">{c.titleLead}<em>{c.titleEm}</em>{c.titleTail}</h2>
          <p class="category-line">{c.line}</p>
        </div>

        <div class="article-grid">
          {c.articles.map((a) => {
            const inner = (
              <>
                <span class="article-card-imgwrap">
                  {a.image ? (
                    <img src={a.image} alt={a.imageAlt} loading="lazy" decoding="async" class="article-card-img" style={`object-position:${objectPosition(a.focal)};`} />
                  ) : (
                    <span class="article-card-img article-card-placeholder" aria-hidden="true"></span>
                  )}
                </span>
                <span class="article-card-body">
                  <span class="article-card-title">{a.title}</span>
                  <span class="article-card-city">{a.city}</span>
                  <span class="article-card-pub">{a.pub}</span>
                  <span class="article-card-preview">{a.preview}</span>
                </span>
              </>
            );
            return a.href ? (
              <a href={a.href} class="article-card reveal" {...(a.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{inner}</a>
            ) : (
              <div class="article-card article-card-soon reveal">{inner}</div>
            );
          })}
        </div>

        <div class="excerpt-carousel reveal" data-excerpt-carousel>
          <button type="button" class="excerpt-arrow excerpt-arrow-prev" data-excerpt-prev aria-label="Previous images" disabled>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
          </button>
          <div class="excerpt-strip" data-excerpt-strip>
            <div class="excerpt-track">
              {c.excerpts.map((ex) => (
                <figure class="excerpt-slide">
                  <button type="button" class="excerpt-open" data-lightbox-src={ex.src} aria-label="View larger">
                    <img src={ex.src} alt={ex.quote} width={ex.w} height={ex.h} loading="lazy" decoding="async" draggable="false" />
                  </button>
                </figure>
              ))}
            </div>
          </div>
          <button type="button" class="excerpt-arrow excerpt-arrow-next" data-excerpt-next aria-label="Next images">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </section>
    ))}

    <!-- ABOUT BARNALI -->
    <section class="about-barnali">
      <div class="about-layout">
        <div class="about-text reveal">
          <div class="section-label">About the Writer</div>
          <h2>Research runs deep. The writing makes it <em>sing.</em></h2>
          <div class="about-copy">
          <p>Before Shunnoh, I spent years in digital marketing and consumer research, using insights and data to understand people: how they search, what they look for, and why they stay on a page. That training did not disappear when I picked up a notebook. It shaped the writer I became.</p>
          <p>Shunnoh means zero in Bengali, and that is how I try to arrive at a place: empty, without a script, open to whatever it chooses to show me. Sometimes that is my own experience, set down as it happened, the discomfort along with the wonder. Sometimes it is a story that needs digging: old records, a weaver explaining his loom, a priest correcting the version on the internet, an elder who remembers what the guidebooks forgot. Either way, I am after the same thing: the place as it is, before it has been polished for visitors.</p>
          <p>But facts on their own rarely move anyone. I write what I find the way it felt to find it: the sweat, the noise, the conversation that changed my mind. The research holds the story up; the rawness keeps it alive.</p>
          <p>That is what I offer your publication: the patience to find the real story, and the craft to make someone live through it.</p>
          </div>
          <div class="about-skills">
            {skills.map((s) => <span class="about-skill-tag">{s}</span>)}
          </div>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="editor-contact" id="contact">
      <h2 class="reveal">Interested in <em>working together?</em></h2>
      <p class="editor-contact-sub reveal reveal-delay-1">I'm open to commissions, contributor roles, and editorial collaborations. Happy to discuss rates, adapt to your house style, or send full drafts of any unpublished piece — reach out on Instagram.</p>
      <a href="https://www.instagram.com/shunnoh_" target="_blank" rel="noopener noreferrer" class="editor-contact-email reveal reveal-delay-2">@shunnoh_ on Instagram</a>
      <div class="editor-cta-explore reveal reveal-delay-3">
        <a href="/">Explore Shunnoh
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>

    <!-- EXCERPT LIGHTBOX -->
    <dialog class="excerpt-lightbox" data-lightbox aria-label="Excerpt image">
      <button type="button" class="excerpt-lightbox-close" data-lightbox-close aria-label="Close">&times;</button>
      <img data-lightbox-img alt="" />
    </dialog>

    <!-- FOOTER -->
    <footer class="ed-footer">
      <p>&copy; 2026 Shunnoh. All rights reserved.</p>
      <p>This page is shared privately with editors and publications.</p>
    </footer>
  </div>
</BaseLayout>

<style>
  .editor-page {
    --ink: #1a1714;
    --parchment: #f5f0e8;
    --warm-white: #faf8f4;
    --sand: #d4c5a9;
    --terracotta: #b8704b;
    --terracotta-deep: #9a5a38;
    --moss-light: #6b7f6b;
    --stone: #8a8175;
    --stone-light: #b0a89c;
    --cream: #ede6d8;
    --charcoal: #2d2a26;
    --font-display: "Playfair Display", Georgia, serif;
    --font-body: "DM Sans", "Helvetica Neue", sans-serif;
    --font-accent: "Cormorant Garamond", Georgia, serif;
    --ease-soft: cubic-bezier(0.25, 0.1, 0.25, 1);
    --ease-out-soft: cubic-bezier(0, 0, 0.2, 1);
    --ease-editorial: cubic-bezier(0.16, 1, 0.3, 1);
    background: var(--warm-white);
    color: var(--ink);
    font-family: var(--font-body);
    line-height: 1.7;
    overflow-x: clip;
    position: relative; isolation: isolate;
    animation: edPageFade 0.5s var(--ease-editorial) both;
  }
  /* Effect 2.8 — background cross-fades between sections. A fixed layer fades
     its opacity (compositor-only) instead of repainting the whole page. */
  .editor-page::after {
    content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background: var(--parchment); opacity: 0;
    transition: opacity 1200ms var(--ease-soft);
  }
  .editor-page.bg-parchment::after { opacity: 1; }
  @keyframes edPageFade { from { opacity: 0; } to { opacity: 1; } }

  /* Effect 2.7 — sticky category label (quiet reader orientation cue) */
  .category-sticky-label {
    position: fixed; top: 5.5rem; left: 3rem; z-index: 900;
    font-family: var(--font-body); font-size: 11px; font-weight: 500;
    letter-spacing: 2px; text-transform: uppercase; color: var(--terracotta);
    background: rgba(250, 248, 244, 0.8);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    padding: 0.45rem 0.9rem; border-radius: 2px;
    opacity: 0; pointer-events: none;
    transition: opacity 400ms var(--ease-soft);
  }
  .category-sticky-label.is-visible { opacity: 1; }
  @media (max-width: 639px) { .category-sticky-label { display: none; } }

  .editor-page ::selection {
    background: rgba(184, 112, 75, 0.2);
    color: #1a1714;
  }

  /* SCROLL REVEAL (editorial — slower, soft blur) */
  .editor-page .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 900ms var(--ease-editorial),
      transform 900ms var(--ease-editorial);
  }
  .editor-page .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .editor-page .reveal-delay-1 { transition-delay: 120ms; }
  .editor-page .reveal-delay-2 { transition-delay: 240ms; }
  .editor-page .reveal-delay-3 { transition-delay: 360ms; }

  /* NAV */
  .ed-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    padding: 1.25rem 3rem;
    display: flex; justify-content: space-between; align-items: center;
    background: rgba(250, 248, 244, 0.92);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 rgba(26, 23, 20, 0.06);
  }
  .ed-nav-logo {
    font-family: var(--font-display); font-size: 1.4rem; font-weight: 500;
    color: var(--ink); text-decoration: none; letter-spacing: 0.02em;
    display: block;
  }
  .ed-nav-logo-img { height: 1.75rem; width: auto; display: block; }
  .ed-nav-links { display: flex; gap: 2.5rem; list-style: none; margin: 0; padding: 0; }
  .ed-nav-links a {
    font-family: var(--font-body); font-size: 0.82rem; font-weight: 400;
    color: var(--stone); text-decoration: none; letter-spacing: 0.08em;
    text-transform: uppercase; transition: color 0.3s ease; position: relative;
  }
  .ed-nav-links a:hover { color: var(--terracotta); }
  .ed-nav-links a::after {
    content: ""; position: absolute; bottom: -4px; left: 0;
    width: 0; height: 1px; background: currentColor; transition: width 400ms var(--ease-soft);
  }
  .ed-nav-links a:hover::after { width: 100%; }

  /* HERO */
  .editor-hero {
    padding: 10rem 6rem 5rem;
    display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 4rem; align-items: center;
  }
  .editor-hero-text { max-width: 760px; }
  .editor-hero-photo {
    /* top 30% of the 3:4 photo cropped away so the face sits nearer the centre */
    aspect-ratio: 15/14; width: 100%; max-width: 480px; justify-self: end;
    border-radius: 12px; overflow: hidden; background: var(--cream);
  }
  .editor-hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center bottom; }
  .editor-hero-badge {
    display: inline-block; font-family: var(--font-body); font-size: 0.65rem;
    font-weight: 500; letter-spacing: 0.25em; text-transform: uppercase;
    color: var(--warm-white); background: var(--terracotta);
    padding: 0.4rem 1rem; margin-bottom: 2.5rem;
  }
  .editor-hero h1 {
    font-family: var(--font-display); font-size: clamp(2.8rem, 5.5vw, 4.2rem);
    font-weight: 400; line-height: 1.1; color: var(--ink);
    margin-bottom: 0; letter-spacing: -0.02em;
  }
  .editor-hero h1 em {
    font-style: italic; color: var(--terracotta);
    text-shadow: 0 1px 0 rgba(184,112,75,0.04);
    display: inline-block;
  }
  .editor-hero-tagline {
    font-family: var(--font-accent); font-style: italic; font-weight: 400;
    font-size: clamp(1.4rem, 2.4vw, 1.8rem); line-height: 1.4; color: var(--ink);
    margin-top: 0.75rem; margin-bottom: 2.5rem; max-width: 680px;
  }
  .editor-hero-intro {
    font-family: var(--font-accent); font-size: clamp(1.2rem, 1.55vw, 1.4rem); font-weight: 300;
    line-height: 1.8; color: var(--stone); max-width: 680px;
  }

  /* HERO LOAD SEQUENCE (Effect 2.1) */
  @keyframes edLoadUp { to { opacity: 1; transform: translateY(0); } }
  @keyframes edMaskReveal { to { opacity: 1; clip-path: inset(0 0 0 0); } }
  .ed-load { opacity: 0; will-change: opacity, transform; }
  .ed-load-badge   { transform: translateY(8px);  animation: edLoadUp 0.7s var(--ease-editorial) 0.4s forwards; }
  .ed-load-h1      { transform: translateY(20px); animation: edLoadUp 0.9s var(--ease-editorial) 0.6s forwards; }
  .ed-load-h1 em   {
    opacity: 0; clip-path: inset(0 100% 0 0);
